# ── Application ──────────────────────────────────────────────────────────────
SECRET_KEY=your_secret_key_here          # generate with: python -c "import secrets; print(secrets.token_hex(32))"
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Database (Docker Compose) ────────────────────────────────────────────────
DB_USER=campususer
DB_PASSWORD=campuspass
DB_NAME=campusfind
DATABASE_URL=postgresql://campususer:campuspass@db:5432/campusfind

# ── File uploads ──────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads

# ── Optional: Admin invite code ───────────────────────────────────────────────
ADMIN_INVITE_CODE=<set-a-private-admin-invite-code>
