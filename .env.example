# ── Application ──────────────────────────────────────────────────────────────
SECRET_KEY=your_secret_key_here          # generate with: python -c "import secrets; print(secrets.token_hex(32))"
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Database (local / non-Docker) ────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=campusfind
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# ── Docker Compose overrides (used by docker-compose.yml) ────────────────────
DB_USER=campususer
DB_PASSWORD=campuspass
DATABASE_URL=postgresql://campususer:campuspass@db:5432/campusfind

# ── File uploads ──────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads

# ── Optional: Admin invite code ───────────────────────────────────────────────
ADMIN_INVITE_CODE=campusfind-admin-2024
