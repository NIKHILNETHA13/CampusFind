# Application
SECRET_KEY=your_secret_key_here          # generate with: python -c "import secrets; print(secrets.token_hex(32))"
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Set to "production" to disable /docs, /redoc, and /openapi.json
# Leave unset or "development" to keep API documentation available locally
ENVIRONMENT=development

# Database (Docker Compose)
DB_USER=campususer
DB_PASSWORD=your_db_password
DB_NAME=campusfind
DATABASE_URL=postgresql://campususer:your_db_password@db:5432/campusfind

# File uploads
UPLOAD_DIR=uploads

# Optional: Admin invite code
ADMIN_INVITE_CODE=<set-a-private-admin-invite-code>

# Optional: Production frontend origin for CORS
# FRONTEND_ORIGIN=https://campusfind.centralindia.cloudapp.azure.com

# Optional: Azure Blob Storage for image persistence (leave blank to use local filesystem)
# AZURE_STORAGE_ACCOUNT_NAME=
# AZURE_STORAGE_ACCOUNT_KEY=
# AZURE_STORAGE_CONTAINER=item-images